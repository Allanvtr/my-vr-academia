# Copie este arquivo para .env (nesta mesma pasta) e preencha com suas credenciais.
# O .env é lido pelo DotNetEnv a partir do diretório de onde o backend é executado.

# Chave da API da Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo da Groq usado para gerar as perguntas
MODEL=llama-3.3-70b-versatile

# Recurso Azure AI Speech (portal Azure > recurso Speech > Chaves e ponto de extremidade)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
